# Backend
APP_ENV=development
APP_PORT=8080
# Inside docker compose:
DATABASE_URL=postgres://goshield:goshield@postgres:5432/goshield?sslmode=disable
# Running the backend on the host instead (compose publishes postgres on 5433):
# DATABASE_URL=postgres://goshield:goshield@localhost:5433/goshield?sslmode=disable
REDIS_URL=redis://redis:6379
WORKER_COUNT=10
QUEUE_SIZE=100
CACHE_TTL_SECONDS=3600
RATE_LIMIT=100
RATE_LIMIT_WINDOW_SECONDS=60
# Origins allowed to call the API from a browser (comma separated).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Frontend
VITE_API_URL=http://localhost:8080/api/v1

# Host port overrides for docker compose (defaults in parentheses)
# FRONTEND_PORT=3000
# BACKEND_PORT=8080
# POSTGRES_PORT=5433
# REDIS_PORT=6379
